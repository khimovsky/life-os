{
  "name": "domain-items",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/items/src",
  "projectType": "library",
  "tags": ["type:domain"],
  "// targets": "to see all targets run: nx show project domain-items --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --project libs/domain/items/tsconfig.lib.json --noEmit",
        "styles": [
          "node_modules/@taiga-ui/core/styles/taiga-ui-theme.less",
          "node_modules/@taiga-ui/core/styles/taiga-ui-fonts.less"
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint ."
      }
    }
  }
}
