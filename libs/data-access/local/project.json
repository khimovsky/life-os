{
  "name": "data-access-local",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/data-access/local/src",
  "projectType": "library",
  "tags": ["type:data-access"],
  "// targets": "to see all targets run: nx show project data-access-local --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --project libs/data-access/local/tsconfig.lib.json --noEmit",
        "styles": [
          "node_modules/@taiga-ui/core/styles/taiga-ui-theme.less",
          "node_modules/@taiga-ui/core/styles/taiga-ui-fonts.less"
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint ."
      }
    }
  }
}
